# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Where the app runs. Must match the redirect URI you register with Google.
APP_URL="http://localhost:3000"

# Google OAuth credentials.
# Get these from https://console.cloud.google.com/apis/credentials
#   1. Create a project
#   2. Enable the "Gmail API"
#   3. Configure the OAuth consent screen (External, add yourself as a test user)
#   4. Create an "OAuth client ID" of type "Web application"
#   5. Add this Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Two independent 32-byte secrets, base64 encoded.
# Generate each one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SESSION_SECRET signs the login cookie.
# ENCRYPTION_KEY encrypts Google refresh tokens before they touch the database.
SESSION_SECRET=""
ENCRYPTION_KEY=""

# Database. SQLite by default so there is nothing to install.
# To deploy, point this at a Turso database (libsql://...) — nothing else changes.
# Turso's URL and token are set as DATABASE_URL and DATABASE_AUTH_TOKEN in Vercel.
DATABASE_URL="file:./local.db"

# Only needed if you deploy to Turso (hosted SQLite). Leave blank locally.
DATABASE_AUTH_TOKEN=""
